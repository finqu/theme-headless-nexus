# Finqu Storefront API Configuration
FINQU_STOREFRONT_URL=https://api.finqu.com/storefront/graphql
FINQU_STOREFRONT_TOKEN=your_storefront_token_here
# Client-side Storefront API (for hooks in browser)
NEXT_PUBLIC_FINQU_STOREFRONT_URL=https://api.finqu.com/storefront/graphql
NEXT_PUBLIC_FINQU_STOREFRONT_TOKEN=your_storefront_token_here
# Finqu Headless Editor Authentication
# Used to validate JWT tokens from Finqu for editor access
# On localhost, authentication is bypassed for development
FINQU_HEADLESS_SECRET_KEY=your_secret_key_here

# Upstash Redis Configuration (Production only)
# Not required for local development - uses file-based storage instead
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
