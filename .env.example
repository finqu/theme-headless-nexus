# Finqu Storefront API Configuration
FINQU_STOREFRONT_URL=https://your.technical.domain/storefront/graphql/
FINQU_STOREFRONT_TOKEN=your_storefront_token_here

# Client-side Storefront API (for hooks in browser)
NEXT_PUBLIC_FINQU_STOREFRONT_URL=https://your.technical.domain/storefront/graphql/
NEXT_PUBLIC_FINQU_STOREFRONT_TOKEN=your_storefront_token_here

# Upstash Redis Configuration (Production only)
# Not required for local development - uses file-based storage instead
KV_REST_API_URL=https://your-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_token_here