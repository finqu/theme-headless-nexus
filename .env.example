# Server-side Storefront GraphQL (RSC, route handlers)
FINQU_STOREFRONT_URL=https://your.technical.domain/storefront/graphql/
FINQU_SECRET_KEY=your_storefront_secret_key_here

# Browser Storefront GraphQL (FinquProvider + React hooks)
NEXT_PUBLIC_FINQU_STOREFRONT_URL=https://your.technical.domain/storefront/graphql/
NEXT_PUBLIC_FINQU_PUBLIC_KEY=your_storefront_public_key_here

# Visual editor JWT (required to open /editor)
# FINQU_EDITOR_SIGNING_KEY=
# FINQU_HEADLESS_SECRET_KEY=

# Upstash Redis — production Puck storage (optional locally; file storage in data/)
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=
